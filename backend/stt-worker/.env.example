# TRON AI STT Worker Configuration
STT_HOST=127.0.0.1
STT_PORT=8091

# Faster-Whisper Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio limits
MAX_AUDIO_BYTES=4194304
MAX_AUDIO_SECONDS=60.0

# Future RTX 4060 CUDA configuration:
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
